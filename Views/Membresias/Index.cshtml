                        <span class="chip chip--muted">Beneficios limitados</span>
                        <span class="chip">Acceso a comunidad</span>
                        <span class="chip">Info institucional</span>
                    </div>
                    <div class="plan-actions">
                        <form asp-controller="Membresias" asp-action="SeleccionarPlan" method="post">

                            @Html.AntiForgeryToken()
                            <input type="hidden" name="plan" value="Cadetes" />
                            <input type="hidden" name="precio" value="5" />
                            <button type="submit" class="btn-plan text-white" style="background: var(--azul);">Elegir Cadetes</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

