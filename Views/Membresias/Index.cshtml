@{
    ViewData["Title"] = "Membresías El Nacional";
}

@section Styles{

<style>
    :root{
        --rojo:#DA291C;
        --azul:#0033A0;
        --gris:#111;
        --fondo:#0b1220;
    }

    .membresias-hero{
        border-radius: 22px;
        background:
            radial-gradient(1200px 400px at 10% 10%, rgba(218,41,28,.28), transparent 60%),
            radial-gradient(1200px 400px at 90% 10%, rgba(0,51,160,.25), transparent 60%),
            linear-gradient(135deg, rgba(17,17,17,.95), rgba(7,10,18,.95));
        padding: 42px 28px;
        color: #fff;
        box-shadow: 0 20px 60px rgba(0,0,0,.35);
        border: 1px solid rgba(255,255,255,.08);
        overflow: hidden;
        position: relative;
    }

    .membresias-hero:before{
        content:"";
        position:absolute;
        inset:-2px;
        background: linear-gradient(90deg, rgba(218,41,28,.35), rgba(0,51,160,.25), rgba(218,41,28,.35));
        filter: blur(18px);
        opacity: .35;
        z-index:0;
    }

    .membresias-hero > *{ position:relative; z-index:1; }

    .membresias-title{
        font-weight: 900;
        letter-spacing: .5px;
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
    }

    .membresias-sub{
        margin: 10px 0 0 0;
        opacity: .9;
    }

    .plan-grid{ margin-top: 26px; }

    .plan-card{
        height: 100%;
        min-height: 520px;
        border-radius: 18px;
        background: #fff;
        border: 1px solid rgba(0,0,0,.06);
        box-shadow: 0 14px 40px rgba(0,0,0,.10);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
        display: flex;
        flex-direction: column;
    }

    .plan-card:hover{
        transform: translateY(-6px);
        box-shadow: 0 22px 70px rgba(0,0,0,.18);
    }

    .plan-head{
        padding: 18px 18px 16px 18px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

    .plan-head:after{
        content:"";
        position:absolute;
        right:-60px;
        top:-60px;
        width: 160px;
        height: 160px;
        background: rgba(255,255,255,.18);
        border-radius: 999px;
        filter: blur(1px);
    }

    .plan-name{
        margin: 0;
        font-weight: 900;
        letter-spacing: .5px;
        text-transform: uppercase;
        font-size: 1rem;
    }

    .plan-badge{
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.25);
        font-size: .78rem;
        font-weight: 700;
        margin-top: 10px;
        width: fit-content;
    }

    .plan-body{
        padding: 18px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .plan-price{
        font-size: 2.2rem;
        font-weight: 900;
        margin: 0;
        color: #111;
        letter-spacing: -.5px;
    }

    .plan-price small{
        font-size: .95rem;
        color: #6c757d;
        font-weight: 700;
    }

    .benefits{
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 175px;
        overflow: auto;
        padding-right: 6px;
    }

    .benefits::-webkit-scrollbar{ width: 8px; }
    .benefits::-webkit-scrollbar-thumb{ background: rgba(0,0,0,.15); border-radius: 999px; }
    .benefits::-webkit-scrollbar-track{ background: rgba(0,0,0,.04); border-radius: 999px; }

    .chip{
        display: inline-flex;
        align-items: center;
        padding: 8px 10px;
        border-radius: 999px;
        font-size: .86rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(0,0,0,.08);
        background: rgba(0,0,0,.03);
        color: #1f2a37;
        white-space: nowrap;
    }

    .chip--muted{
        background: rgba(218,41,28,.06);
        border-color: rgba(218,41,28,.18);
        color: #7a1a14;
    }

    .plan-actions{
        margin-top: auto;
        padding-top: 16px;
    }

    .btn-plan{
        width: 100%;
        border-radius: 12px;
        padding: 12px 14px;
        font-weight: 800;
        letter-spacing: .3px;
        border: none;
        transition: transform .2s ease, filter .2s ease;
    }

    .btn-plan:hover{ transform: translateY(-1px); filter: brightness(1.02); }

    .divider-soft{
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(0,0,0,.15), transparent);
        margin: 46px 0 26px 0;
    }

    .tabla-wrap{
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 16px 50px rgba(0,0,0,.10);
        border: 1px solid rgba(0,0,0,.06);
        background: #fff;
    }

    .tabla-title{
        font-weight: 900;
        color: var(--azul);
        margin: 0;
        letter-spacing: .3px;
    }

    .tabla-sub{
        margin: 6px 0 0 0;
        color: #6c757d;
        font-weight: 600;
    }

    .table thead th{
        background: #0f172a !important;
        color: #fff !important;
        border-color: rgba(255,255,255,.08) !important;
        font-weight: 900;
        letter-spacing: .3px;
        padding: 14px 12px;
        vertical-align: middle;
    }

    .table td{
        padding: 12px;
        vertical-align: middle;
    }

    .benef-dot{
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 1rem;
    }

    .benef-dot--on{
        background: rgba(34,197,94,.12);
        color: #15803d;
        border: 1px solid rgba(34,197,94,.25);
    }

    .benef-dot--off{
        background: rgba(148,163,184,.18);
        color: #64748b;
        border: 1px solid rgba(148,163,184,.25);
    }

    .sticky-col{
        position: sticky;
        left: 0;
        background: #fff;
        z-index: 2;
    }

    .table thead .sticky-col{
        background: #0f172a;
        z-index: 3;
    }

    @@media (max-width: 992px){
        .sticky-col{ position: static; }
        .plan-card{ min-height: 480px; }
        .benefits{ max-height: none; overflow: visible; }
    }
    }
</style>
}


<div class="container py-5">

