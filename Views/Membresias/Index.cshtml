@{
    ViewData["Title"] = "Membresías El Nacional";
}

@section Styles {
    <style>
        :root {
            --rojo: #DA291C;
            --azul: #0033A0;
            --gris: #111;
            --fondo: #0b1220;
        }

        /* HERO */
        .membresias-hero {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d0a0a 50%, #DA291C 100%);
            padding: 60px 0 40px;
            margin-bottom: 40px;
        }

            .membresias-hero h1 {
                font-size: 2.5rem;
                font-weight: 900;
                color: white;
                text-transform: uppercase;
                letter-spacing: 2px;
            }

            .membresias-hero p {
                color: rgba(255,255,255,0.7);
                font-size: 1rem;
            }

        /* PLAN CARDS */
        .plan-card {
            height: 100%;
            min-height: 520px;
            border-radius: 16px;
            background: white;
            border: none;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
            display: flex;
            flex-direction: column;
        }

            .plan-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 35px rgba(218, 41, 28, 0.25);
                background: linear-gradient(180deg, rgba(218, 41, 28, 0.05) 0%, white 40%);
            }

        .plan-head {
            padding: 20px;
            color: white;
            position: relative;
            overflow: hidden;
        }

            .plan-head:after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 160px;
                height: 160px;
                background: rgba(255,255,255,0.18);
                border-radius: 999px;
                filter: blur(1px);
            }

        .plan-name {
            margin: 0;
            font-weight: 900;
            letter-spacing: .5px;
            text-transform: uppercase;
            font-size: 1rem;
        }

        .plan-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,0.18);
            border: 1px solid rgba(255,255,255,0.25);
            font-size: .78rem;
            font-weight: 700;
            margin-top: 10px;
            width: fit-content;
        }

        .plan-body {
            padding: 18px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .plan-price {
            font-size: 2.2rem;
            font-weight: 900;
            margin: 0;
            color: #111;
            letter-spacing: -.5px;
        }

            .plan-price small {
                font-size: .95rem;
                color: #6c757d;
                font-weight: 700;
            }

        .benefits {
            margin-top: 14px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-height: 175px;
            overflow: auto;
            padding-right: 6px;
        }

            .benefits::-webkit-scrollbar {
                width: 8px;
            }

            .benefits::-webkit-scrollbar-thumb {
                background: rgba(0,0,0,.15);
                border-radius: 999px;
            }

            .benefits::-webkit-scrollbar-track {
                background: rgba(0,0,0,.04);
                border-radius: 999px;
            }

        .chip {
            display: inline-flex;
            align-items: center;
            padding: 8px 10px;
            border-radius: 999px;
            font-size: .86rem;
            font-weight: 600;
            line-height: 1;
            border: 1px solid rgba(0,0,0,.08);
            background: rgba(0,0,0,.03);
            color: #1f2a37;
            white-space: nowrap;
        }

        .chip--muted {
            background: rgba(218,41,28,.06);
            border-color: rgba(218,41,28,.18);
            color: #7a1a14;
        }

        .plan-actions {
            margin-top: auto;
            padding-top: 16px;
        }

        .btn-plan {
            width: 100%;
            border-radius: 50px;
            padding: 12px 14px;
            font-weight: 800;
            letter-spacing: .3px;
            border: none;
            transition: transform .2s ease, filter .2s ease;
        }

            .btn-plan:hover {
                transform: translateY(-1px);
                filter: brightness(1.08);
            }

        /* UBICACION */
        .ubicacion-card {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d0a0a 50%, #DA291C 100%);
            border-radius: 16px;
            padding: 42px 28px;
            color: white;
            box-shadow: 0 20px 60px rgba(0,0,0,.35);
            margin-bottom: 46px;
        }

        .ubicacion-title {
            font-weight: 900;
            font-size: clamp(1.5rem, 3vw, 2.2rem);
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .ubicacion-subtitle {
            margin: 0 0 24px 0;
            opacity: .9;
            font-size: 1.05rem;
        }

        .ubicacion-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            padding: 24px;
            background: rgba(255,255,255,.08);
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,.12);
            backdrop-filter: blur(10px);
        }

        .ubicacion-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .ubicacion-item-icon {
            font-size: 2.2rem;
            margin-bottom: 12px;
        }

        .ubicacion-item-label {
            margin: 0 0 6px 0;
            font-size: 0.95rem;
            opacity: 0.85;
            text-transform: uppercase;
            letter-spacing: .3px;
            font-weight: 600;
        }

        .ubicacion-item-valor {
            margin: 0;
            font-weight: 700;
            font-size: 1.1rem;
        }

        .ubicacion-item-detalle {
            margin: 4px 0 0 0;
            opacity: 0.85;
            font-size: 0.95rem;
        }

        .ubicacion-divider {
            height: 80px;
            width: 1px;
            background: linear-gradient(180deg, transparent, rgba(255,255,255,.2), transparent);
            justify-self: center;
        }

        /* TABLA */
        .divider-soft {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0,0,0,.15), transparent);
            margin: 46px 0 26px 0;
        }

        .tabla-wrap {
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,.10);
            border: 1px solid rgba(0,0,0,.06);
            background: #fff;
        }

        .tabla-title {
            font-weight: 900;
            color: var(--azul);
            margin: 0;
            letter-spacing: .3px;
            font-size: 2rem;
        }

        .tabla-sub {
            margin: 6px 0 0 0;
            color: #6c757d;
            font-weight: 600;
        }

        .table thead th {
            background: #1a1a1a !important;
            color: #fff !important;
            border-color: rgba(255,255,255,.08) !important;
            font-weight: 900;
            letter-spacing: .3px;
            padding: 14px 12px;
            vertical-align: middle;
        }

        .table td {
            padding: 12px;
            vertical-align: middle;
        }

        .benef-dot {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            border-radius: 999px;
            font-weight: 900;
            font-size: 1rem;
        }

        .benef-dot--on {
            background: rgba(218,41,28,.12);
            color: #DA291C;
            border: 1px solid rgba(218,41,28,.25);
        }

        .benef-dot--off {
            background: rgba(148,163,184,.18);
            color: #64748b;
            border: 1px solid rgba(148,163,184,.25);
        }

        .sticky-col {
            position: sticky;
            left: 0;
            background: #fff;
            z-index: 2;
        }

        .table thead .sticky-col {
            background: #1a1a1a;
            z-index: 3;
        }

        @@media (max-width: 768px) {
            .ubicacion-content {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .ubicacion-divider {
                height: 1px;
                width: 100%;
            }

            .sticky-col {
                position: static;
            }

            .plan-card {
                min-height: 480px;
            }

            .benefits {
                max-height: none;
                overflow: visible;
            }
        }
    </style>
}

<!-- HERO -->
<div class="membresias-hero">
    <div class="container text-center">
        <h1><i class="bi bi-shield-fill-check me-2"></i>Hazte Socio del Bitri</h1>
        <p>Elige el plan que mejor se adapte a tu pasión por El Nacional.</p>
    </div>
</div>

<div class="container pb-5">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["Error"]</div>
    }

    <!-- PLANES -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5">

        <div class="col">
            <div class="plan-card">
                <div class="plan-head" style="background: linear-gradient(135deg, #0033A0, #0b1f57);">
                    <h4 class="plan-name">Cadetes</h4>
                    <span class="plan-badge">Plan base</span>
                </div>
                <div class="plan-body">
                    <p class="plan-price">$5 <small>/mes</small></p>
