    </div>

    <!-- UBICACION -->
    <div class="ubicacion-card text-center">
        <h2 class="ubicacion-title"><i class="bi bi-geo-alt-fill me-2"></i>¡Visítanos en persona!</h2>
        <p class="ubicacion-subtitle">También puedes hacerte socio visitando nuestras instalaciones</p>
