@model ProyectoIdentity.Models.Escuela

<div class="container mt-4">
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">@(Model.Id == 0 ? "Registrar Nueva Escuela" : "Editar Escuela: " + Model.Nombre)</h3>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <input type="hidden" asp-for="Id" />

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-bold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Region" class="form-label fw-bold"></label>
                        <select asp-for="Region" class="form-select">
                            <option value="Sierra">Sierra</option>
                            <option value="Costa">Costa</option>
                            <option value="Oriente">Oriente</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5>Sedes Asociadas</h5>
                    <button type="button" onclick="agregarSede()" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus"></i> Añadir Sede
                    </button>
                </div>

                <div id="contenedor-sedes">
                    @for (int i = 0; i < Model.Sedes.Count; i++)
                    {
                        var sede = Model.Sedes.ToList()[i];
                        <div class="sede-item card p-3 mb-3 bg-light border-0">
                            <div class="d-flex justify-content-between mb-2">
                                <h6 class="titulo-sede">Sede #@(i + 1)</h6>
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="eliminarSede(this)">Borrar</button>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-4"><input name="Sedes[@i].Direccion" class="form-control form-control-sm" value="@sede.Direccion" placeholder="Dirección" required /></div>
                                <div class="col-md-4"><input name="Sedes[@i].Horarios" class="form-control form-control-sm" value="@sede.Horarios" placeholder="Horarios" required /></div>
                                <div class="col-md-4"><input name="Sedes[@i].Ciudad" class="form-control form-control-sm" value="@sede.Ciudad" placeholder="Ciudad" /></div>
                            </div>
                        </div>
                    }
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2 fw-bold">GUARDAR CAMBIOS</button>
                @if (Model.Id != 0)
                {
                    <a asp-action="Create" class="btn btn-link w-100 text-muted mt-2">Cancelar Edición</a>
                }
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Escuelas Registradas</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Región</th>
                        <th>Sedes</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in (IEnumerable<ProyectoIdentity.Models.Escuela>)ViewBag.TodasLasEscuelas)
                    {
                        <tr>
                            <td class="fw-bold">@item.Nombre</td>
                            <td><span class="badge bg-info text-dark">@item.Region</span></td>
                            <td>@item.Sedes.Count sedes</td>
                            <td class="text-end">
                                <a asp-action="Create" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Borrar esta escuela y sus sedes?')">
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let contadorSedes = 1;
        function agregarSede() {
            const contenedor = document.getElementById('contenedor-sedes');
            const nuevaSede = document.createElement('div');
            nuevaSede.className = 'sede-item card p-3 mb-3 shadow-sm border-primary';
            nuevaSede.innerHTML = `
                        <h5>Sede #${contadorSedes + 1}</h5>
                        <div class="row g-3">
                            <div class="col-md-4"><input name="Sedes[${contadorSedes}].Direccion" class="form-control" placeholder="Dirección *" required /></div>
                            <div class="col-md-4"><input name="Sedes[${contadorSedes}].Horarios" class="form-control" placeholder="Días y Horarios *" required /></div>
                            <div class="col-md-4"><input name="Sedes[${contadorSedes}].Ciudad" class="form-control" placeholder="Ciudad" /></div>
                            <div class="col-md-4"><input name="Sedes[${contadorSedes}].Telefono" class="form-control" placeholder="Teléfono" /></div>
                            <div class="col-md-4"><input name="Sedes[${contadorSedes}].Responsable" class="form-control" placeholder="Coordinador" /></div>
                            <div class="col-md-4"><input name="Sedes[${contadorSedes}].MapaLink" class="form-control" placeholder="Link Google Maps" /></div>
                        </div>
                    `;
            contenedor.appendChild(nuevaSede);
            contadorSedes++;
        }
    </script>
}