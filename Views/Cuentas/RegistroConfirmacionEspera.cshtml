@{
    ViewData["Title"] = "Confirmación en camino";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h1 style="color: #DA291C;"><i class="bi bi-envelope-check"></i> ¡Casi listo!</h1>
                    <p class="lead mt-3">Hemos enviado un enlace de activación a tu correo electrónico.</p>
                    <hr />
                    <p>Por favor, revisa tu bandeja de entrada (y la carpeta de <strong>correo no deseado o spam</strong>) para confirmar tu registro.</p>
                    <div class="mt-4">
                        <a asp-action="Acceso" class="btn btn-dark btn-lg">Ir al Inicio de Sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>