@model IEnumerable<ProyectoIdentity.Models.Ubicacion>
@{
    ViewData["Title"] = "Nuestros Locales";
}

<style>
    .locales-hero {
        background: linear-gradient(135deg, #1a1a1a 0%, #2d0a0a 50%, #DA291C 100%);
        padding: 60px 0 40px;
        margin-bottom: 40px;
    }

        .locales-hero h2 {
            font-size: 2.5rem;
            font-weight: 900;
            color: white;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .locales-hero p {
            color: rgba(255,255,255,0.7);
            font-size: 1rem;
        }

    .search-bar {
        background: rgba(255,255,255,0.1);
        border-radius: 50px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.2);
    }

        .search-bar input {
            background: transparent;
            border: none;
            color: white;
            padding: 12px 20px;
        }

            .search-bar input::placeholder {
                color: rgba(255,255,255,0.5);
            }

            .search-bar input:focus {
                background: transparent;
                box-shadow: none;
                color: white;
            }

        .search-bar button {
            border-radius: 0 50px 50px 0;
            padding: 12px 25px;
            background-color: #DA291C;
            border: none;
            color: white;
            font-weight: bold;
        }

    .local-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: white;
    }

        .local-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 35px rgba(218, 41, 28, 0.5);
            background: linear-gradient(180deg, rgba(218, 41, 28, 0.05) 0%, white 40%);
        }

    .local-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
        background: white;
    }

    .local-card-header {
        background: linear-gradient(135deg, #DA291C, #8b0000);
        padding: 20px;
        color: white;
    }

        .local-card-header h5 {
            font-weight: 800;
            font-size: 1.1rem;
            margin: 0;
        }

    .ciudad-badge {
        background: rgba(255,255,255,0.2);
        color: white;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid rgba(255,255,255,0.3);
    }

    .local-card-body {
        padding: 20px;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 12px;
        color: #444;
        font-size: 0.9rem;
    }

        .info-item i {
            color: #DA291C;
            margin-top: 2px;
            min-width: 16px;
        }

    .btn-ver-ubicacion {
        background: linear-gradient(135deg, #DA291C, #8b0000);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 8px 20px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: opacity 0.3s;
        width: 100%;
        text-align: center;
    }

        .btn-ver-ubicacion:hover {
            opacity: 0.85;
            color: white;
        }

    .no-locales {
        text-align: center;
        padding: 60px 20px;
        color: #888;
    }

        .no-locales i {
            font-size: 3rem;
            color: #DA291C;
            margin-bottom: 15px;
        }
</style>

<div class="locales-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-3 mb-md-0">
                <h2><i class="bi bi-geo-alt-fill me-2"></i>Nuestros Locales</h2>
                <p>Encuentra tu tienda Kao más cercana</p>
            </div>
            <div class="col-md-4">
                <form asp-action="Index" method="get" class="d-flex search-bar">
                    <input type="text" name="buscarCiudad" class="form-control"
                           placeholder="Buscar por ciudad..." value="@ViewData["FiltroActual"]" />
                    <button type="submit"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <div class="col-md-2 text-end">
                @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                {
                    <a asp-action="Crear" class="btn btn-light fw-bold shadow-sm">
                        <i class="bi bi-plus-circle me-1"></i> Agregar
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (!Model.Any())
    {
        <div class="no-locales">
            <i class="bi bi-shop-window d-block"></i>
            <h5>No se encontraron locales</h5>
            <p>Intenta con otra ciudad</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="local-card h-100">
                        <div class="local-card-header d-flex justify-content-between align-items-center">
                            <h5>@item.Nombre</h5>
                            <span class="ciudad-badge">@item.Ciudad</span>
                        </div>
                        <div class="local-card-body">
                            <div class="info-item">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@item.Direccion</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-telephone-fill"></i>
                                <span>@item.Celular</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-clock-fill"></i>
                                <span>@item.Horario</span>
                            </div>

                            <div class="mt-3 d-grid gap-2">
                                @if (!string.IsNullOrEmpty(item.Link))
                                {
                                    <a href="@item.Link" target="_blank" class="btn-ver-ubicacion">
                                        <i class="bi bi-map-fill me-1"></i> Ver Ubicación
                                    </a>
                                }
                                @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                                {
                                    <div class="d-flex gap-2 mt-2">
                                        <a asp-action="Crear" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm flex-fill">
                                            <i class="bi bi-pencil-fill"></i> Editar
                                        </a>
                                        <form asp-action="Borrar" asp-route-id="@item.Id" method="post" class="flex-fill">
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                                                    onclick="return confirm('¿Eliminar local?');">
                                                <i class="bi bi-trash-fill"></i> Borrar
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>