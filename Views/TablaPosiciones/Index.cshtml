@model List<ProyectoIdentity.Models.TablaPosicion>
@{
    ViewData["Title"] = "Tabla de Posiciones";
    Layout = "_Layout";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-white">Tabla de Posiciones</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-success">
            Ver en Inicio <i class="bi bi-house"></i>
        </a>
    </div>

    <!-- Formulario Agregar -->
    <div class="card mb-4">
        <div class="card-header fw-bold">Agregar equipo (uno por uno)</div>
        <div class="card-body">
            <form asp-action="Crear" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Posición</label>
                        <input name="Posicion" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Club</label>
                        <input name="Club" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Puntos</label>
                        <input name="Puntos" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Escudo (imagen)</label>
                        <input type="file" name="archivoImagen" class="form-control" accept="image/*" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-danger">Guardar equipo</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card">
        <div class="card-header fw-bold">Equipos cargados (@Model.Count)</div>
        <div class="card-body p-0">
            <table class="table table-bordered table-striped align-middle m-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:80px;">Pos</th>
                        <th style="width:90px;" class="text-center">Escudo</th>
                        <th>Club</th>
                        <th style="width:110px;">Puntos</th>
                        <th style="width:130px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Posicion</td>
                            <td class="text-center">
                                @if (item.ImagenClub != null && item.ImagenClub.Length > 0)
                                {
                                    <img src="data:image/png;base64,@Convert.ToBase64String(item.ImagenClub)" height="35" />
                                }
                                else
                                {
                                    <span class="text-muted">Sin</span>
                                }
                            </td>
                            <td>@item.Club</td>
                            <td class="fw-bold">@item.Puntos</td>
                            <td class="text-center">
                                <!-- Botón Editar -->
                                <button class="btn btn-warning btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEditar"
                                        data-id="@item.Id"
                                        data-posicion="@item.Posicion"
                                        data-club="@item.Club"
                                        data-puntos="@item.Puntos">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <!-- Botón Eliminar -->
                                <form asp-action="Eliminar" method="post" style="display:inline"
                                      onsubmit="return confirm('¿Eliminar a @item.Club?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Equipo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Editar" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editId" />
                    <div class="mb-3">
                        <label class="form-label">Posición</label>
                        <input name="Posicion" id="editPosicion" type="number" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Club</label>
                        <input name="Club" id="editClub" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Puntos</label>
                        <input name="Puntos" id="editPuntos" type="number" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nuevo Escudo (opcional)</label>
                        <input type="file" name="archivoImagen" class="form-control" accept="image/*" />
                        <small class="text-muted">Dejar vacío para conservar el escudo actual.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Cargar datos en el modal al abrir
        document.getElementById('modalEditar').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('editId').value = btn.getAttribute('data-id');
            document.getElementById('editPosicion').value = btn.getAttribute('data-posicion');
            document.getElementById('editClub').value = btn.getAttribute('data-club');
            document.getElementById('editPuntos').value = btn.getAttribute('data-puntos');
        });
    </script>
}