@model AppUsuario

@{
    ViewData["Title"] = "Panel del Socio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <div class="card shadow-sm mb-4" style="border-left: 6px solid #d10000;">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h3 class="mb-1">Bienvenido/a, @Model?.Nombre</h3>
                <div class="text-muted">
                    Socio: <strong>@(Model?.TipoMembresia ?? "Sin plan")</strong> ·
                    Estado: <strong>@(Model?.EstadoMembresia ?? "Sin estado")</strong>
                    @if (Model?.FechaFinMembresia != null)
                    {
                        <span> · Válida hasta: <strong>@Model.FechaFinMembresia?.ToString("dd/MM/yyyy")</strong></span>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-danger" asp-controller="Membresias" asp-action="MiMembresia">
                    <i class="bi bi-person-badge me-1"></i> Ver mi membresía
                </a>
                <a class="btn btn-outline-danger" asp-controller="Usuarios" asp-action="EditarPerfil" asp-route-id="@Model?.Id">
                    <i class="bi bi-pencil-square me-1"></i> Editar perfil
                </a>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-4 justify-content-center">

        <div class="card shadow-sm" style="width: 330px;">
            <div class="card-header text-white" style="background:#d10000;">
                <strong>MI PLAN</strong>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-star-fill" style="font-size:40px;"></i>
                </div>

                <h5 class="mb-2">@((Model?.TipoMembresia ?? "Aún no tienes plan"))</h5>

                @if (Model?.EstadoMembresia == "Activa" && Model?.FechaFinMembresia != null)
                {
                    <div class="text-muted mb-3">
                        Válida hasta: <strong>@Model.FechaFinMembresia?.ToString("dd/MM/yyyy")</strong>
                    </div>
                }
                else
                {
                    <div class="text-muted mb-3">Contrata tu plan para activar tus beneficios.</div>
                }

                <a class="btn btn-danger w-100" asp-controller="Membresias" asp-action="Index">
                    <i class="bi bi-lightning-charge me-1"></i> Ver planes
                </a>
            </div>
        </div>

        <div class="card shadow-sm" style="width: 330px;">
            <div class="card-header text-white" style="background:#d10000;">
                <strong>ENTRADAS</strong>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-ticket-perforated-fill" style="font-size:40px;"></i>
                </div>

                <div class="text-muted mb-3">
                    Próximo partido: <strong>Próximamente</strong>
                </div>

                <a class="btn btn-outline-danger w-100" href="#">
                    <i class="bi bi-cart-check me-1"></i> Comprar entradas
                </a>
            </div>
        </div>

        <div class="card shadow-sm" style="width: 330px;">
            <div class="card-header text-white" style="background:#d10000;">
                <strong>MI CARNET DE SOCIO</strong>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-credit-card-2-front-fill" style="font-size:40px;"></i>
                </div>

                <div class="text-muted mb-3">
                    @if (Model?.EstadoMembresia == "Activa")
                    {
                        <span>Carnet disponible para socios activos.</span>
                    }
                    else
                    {
                        <span>Activa tu membresía para generar tu carnet.</span>
                    }
                </div>

                <a class="btn btn-danger w-100" href="#">
                    <i class="bi bi-qr-code-scan me-1"></i> Ver carnet
                </a>
            </div>
        </div>

    </div>

</div>
