@model AppUsuario

@{
    ViewData["Title"] = "Carnet Digital";
}

<style>
    :root {
        --nacional-rojo: #DA291C;
    }

    /* Contenedor para centrar la tarjeta en la pantalla */
    .carnet-wrapper {
        perspective: 1000px;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
    }

    .carnet-card {
        /* Dimensiones estándar de tarjeta de crédito/ID */
        width: 450px;
        height: 270px;
        border-radius: 18px;
        overflow: hidden;
        background: linear-gradient(135deg, #1a1a1a 0%, #3a0a0a 50%, #DA291C 100%);
        color: white;
        box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        font-family: 'Montserrat', sans-serif;
        position: relative;
        border: 1px solid rgba(255,255,255,0.1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        /* Brillo sutil de tarjeta plástica */
        .carnet-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(105deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 50%);
            pointer-events: none;
        }

    .carnet-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
    }

    .carnet-body {
        padding: 0 25px 15px 25px;
        text-align: left; /* Alineación lateral para look de ID */
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .tipo-socio {
        background: white;
        color: black;
        display: inline-block;
        padding: 2px 12px;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 800;
        margin-bottom: 8px;
        text-transform: uppercase;
        width: fit-content;
    }

    .carnet-body h4 {
        margin: 0;
        text-transform: uppercase;
        font-weight: 900;
        font-size: 1.6rem;
        letter-spacing: 1px;
        line-height: 1.1;
    }

    .user-email {
        font-size: 0.75rem;
        opacity: 0.8;
        margin-top: 2px;
    }

    .carnet-info {
        display: flex;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 10px;
        border-top: 1px solid rgba(255,255,255,0.2);
    }

    .info-box small {
        display: block;
        text-transform: uppercase;
        font-size: 0.55rem;
        opacity: 0.7;
        letter-spacing: 1px;
    }

    .info-box strong {
        font-size: 0.85rem;
        font-weight: 700;
    }

    /* Ajuste para móviles */
    @@media (max-width: 480px) {
        .carnet-card {
            width: 90vw;
            height: 55vw;
        }

        .carnet-body h4 {
            font-size: 1.2rem;
        }
    }

    /* FLIP */
    .carnet-flip {
        width: 450px;
        height: 270px;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.4s ease;
        touch-action: pan-y;
    }

    /* 🔥 ESTE ES EL FIX REAL */
    .carnet-wrapper:hover .carnet-flip {
        transform: rotateY(180deg);
    }

    /* CARAS */
    .front, .back {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
    }

    /* REVERSO */
    .back {
        transform: rotateY(180deg);
    }

    .carnet-flip.flip {
        transform: rotateY(180deg);
    }

</style>

<div class="container mt-5 mb-5">
    <div class="carnet-wrapper">

        <div class="carnet-flip">

            <!-- 🔴 FRENTE -->
            <div class="carnet-card front">

                <div class="carnet-header">
                    <img src="~/media/escudo.png" height="45" alt="Escudo" />
                    <div class="text-end">
                        <span style="font-size: 0.7rem; letter-spacing: 2px; display: block; font-weight: 800;">BITRICAMPEÓN</span>
                        <span style="font-size: 0.5rem; opacity: 0.8;">CLUB DEPORTIVO EL NACIONAL</span>
                    </div>
                </div>

                <div class="carnet-body">
                    <div class="tipo-socio">SOCIO @(Model.TipoMembresia ?? "GENERAL")</div>
                    <h4>@Model.Nombre</h4>
                    <p class="user-email">@Model.Email</p>

                    <div class="carnet-info">
                        <div class="info-box">
                            <small>Socio ID</small>
                            <strong>@Model.Cedula</strong>
                        </div>
                        <div class="info-box text-end">
                            <small>Válido hasta</small>
                            <strong>@(Model.FechaFinMembresia?.ToString("MM / yyyy") ?? "N/A")</strong>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ⚫ REVERSO -->
            <div class="carnet-card back d-flex flex-column justify-content-between text-center p-3">

                <div>
                    <p style="font-size: 0.65rem; opacity: 0.7;">
                        Documento digital válido del Club Deportivo El Nacional
                    </p>

                    <div style="font-size: 0.6rem; opacity: 0.85;">
                        <div>
                            <i class="bi bi-envelope"></i> soporte@elnacional.ec
                        </div>
                        <div>
                            <i class="bi bi-telephone"></i> +593 99 999 9999
                        </div>
                        <div>
                            <a href="#" style="color: white; text-decoration: underline;">
                                Centro de ayuda
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>

<script>
    const card = document.querySelector('.carnet-flip');

    let currentAngle = 0;
    let startX = 0;
    let angleAtStart = 0;
    let isTouching = false;

    function setAngle(angle, animate = false) {
        card.style.transition = animate ? 'transform 0.3s ease' : 'none';
        card.style.transform = `rotateY(${angle}deg)`;
        currentAngle = angle;
    }

    // ── TOUCH ──────────────────────────────────────────────
    card.addEventListener('touchstart', (e) => {
        isTouching = true;
        startX = e.touches[0].clientX;
        angleAtStart = currentAngle;
        card.style.transition = 'none';
    });

    card.addEventListener('touchmove', (e) => {
        e.preventDefault();
        const diff = e.touches[0].clientX - startX;
        // Izquierda = ángulo positivo (gira hacia reverso), derecha = negativo
        setAngle(angleAtStart - diff);
    }, { passive: false });

    card.addEventListener('touchend', (e) => {
        // La tarjeta se queda exactamente donde el usuario soltó
        // Solo bloqueamos el click que dispara el navegador tras el toque
        setTimeout(() => { isTouching = false; }, 300);
    });

    // ── CLICK (PC y tap simple sin arrastre) ───────────────
    card.addEventListener('click', (e) => {
        if (isTouching) return;

        const rect = card.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const half = rect.width / 2;

        if (clickX < half) {
            // Click lado izquierdo → gira por la izquierda (resta 180°)
            setAngle(currentAngle - 180, true);
        } else {
            // Click lado derecho → gira por la derecha (suma 180°)
            setAngle(currentAngle + 180, true);
        }
    });
</script>