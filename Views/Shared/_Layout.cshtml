<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - El Nacional</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">   
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" type="image/png" href="~/media/escudo.png" />
    <link rel="apple-touch-icon" href="~/media/escudo.png" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        :root {
            --nacional-rojo: #DA291C;
            --nacional-azul: #0033A0;
            --nacional-gris: #A2AAAD;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f9fa;
        }

        /* NAVBAR PREMIUM */
        .navbar-custom {
            background: rgba(0, 0, 0, 0.8) !important; /* Fondo oscuro traslúcido */
            backdrop-filter: blur(15px); /* Efecto cristal esmerilado */
            -webkit-backdrop-filter: blur(15px);
            border-bottom: 2px solid var(--nacional-rojo);
            padding: 15px 0;
            transition: all 0.4s ease;
        }

        .navbar-brand img {
            transition: transform 0.3s ease;
        }

        .navbar-brand:hover img {
            transform: scale(1.1);
        }

        .nav-link {
            color: white !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            margin: 0 10px;
            position: relative;
            transition: color 0.3s ease;
        }

            /* Línea animada debajo de los links (EXCEPTO dropdown) */
            .nav-link:not(.dropdown-toggle)::after {
                content: '';
                position: absolute;
                width: 0;
                height: 2px;
                bottom: -5px;
                left: 0;
                background-color: var(--nacional-rojo);
                transition: width 0.3s ease;
            }

            .nav-link:not(.dropdown-toggle):hover::after {
                width: 100%;
            }

            .nav-link:hover {
                color: var(--nacional-rojo) !important;
            }

            /* Flecha del dropdown */
            .nav-link.dropdown-toggle::after {
                content: '' !important;
                position: static !important;
                display: inline-block !important;
                margin-left: 0.5em !important;
                vertical-align: 0.15em !important;
                width: auto !important;
                height: auto !important;
                border-top: 0.4em solid white !important;
                border-right: 0.4em solid transparent !important;
                border-bottom: 0 !important;
                border-left: 0.4em solid transparent !important;
                background-color: transparent !important;
                transition: border-top-color 0.3s ease !important;
            }

            /* Cambiar color de flecha en hover - sin animación de línea */
            .nav-link.dropdown-toggle:hover::after {
                border-top-color: var(--nacional-rojo) !important;
                width: auto !important;
            }

        /* Botón de Socio en el Nav */
        .btn-nav-socio {
            background-color: var(--nacional-rojo);
            color: white !important;
            border-radius: 50px;
            padding: 8px 20px !important;
            font-weight: 700 !important;
            box-shadow: 0 4px 15px rgba(218, 41, 28, 0.3);
        }

            .btn-nav-socio:hover {
                background-color: white;
                color: var(--nacional-rojo) !important;
                transform: translateY(-2px);
            }

        /* Para que no haya saltos de diseño */
        .main-content {
            min-height: 80vh;
        }

        /* Estilo para los links dentro del partial de login */
        .navbar-custom .login-partial-link {
            color: white !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            text-decoration: none;
            transition: color 0.3s;
        }

            .navbar-custom .login-partial-link:hover {
                color: var(--nacional-rojo) !important;
            }

        /* Separador visual entre Iniciar Sesión y Registro si están juntos */
        .auth-separator {
            color: rgba(255,255,255,0.3);
            margin: 0 5px;
        }

        /* Estilo para el menú desplegable */
        .dropdown-menu {
            background-color: #0033A0; /* Azul Nacional */
            border: none;
            border-top: 3px solid #DA291C; /* Línea superior Roja */
        }

        .dropdown-item {
            color: white !important;
            font-weight: 500;
            padding: 10px 20px;
            transition: all 0.3s;
        }

            .dropdown-item:hover {
                background-color: #DA291C; /* Fondo rojo al pasar el mouse */
                color: white !important;
                padding-left: 25px; /* Efecto sutil de movimiento */
            }

            /* EFECTO HOVER PARA DROPDOWNS */
@@media (min-width: 992px) {
    /* Muestra el menú al pasar el mouse por el contenedor li */
    .nav-item.dropdown:hover > .dropdown-menu {
        display: block;
        margin-top: 0; /* Evita saltos visuales */
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        transition: all 0.3s ease;
    }

    /* Pequeño ajuste para que no se cierre el menú al intentar bajar el mouse */
    .dropdown-menu {
        margin-top: 0;
        display: block;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.3s ease;
    }
}

        /* ESTILOS FOOTER */
        .sponsor-img {
            height: 40px;
            filter: grayscale(100%) brightness(0.8);
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .sponsor-img:hover {
                filter: grayscale(0%) brightness(1);
                transform: scale(1.1);
            }

        .footer-logo {
            filter: drop-shadow(0 0 10px rgba(255,255,255,0.1));
        }

        .grayscale-logo {
            filter: brightness(0) invert(1);
            opacity: 0.6;
            transition: opacity 0.3s;
        }

            .grayscale-logo:hover {
                opacity: 1;
            }

        .social-icons a i {
            transition: transform 0.3s, color 0.3s;
        }

        .social-icons a:hover i {
            color: var(--nacional-rojo);
            transform: scale(1.2);
        }

        /* Para asegurar que el footer siempre este abajo */
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/media/escudo.png" height="50" alt="El Nacional">
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto align-items-center">

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-uppercase fw-bold"
                           href="https://www.kaosport.com/club-deportivo-el-nacional/nacional,%20cuenca,%20aucas,quito?_q=nacional,%20cuenca,%20aucas,quito&fuzzy=auto&initialMap=ft&initialQuery=nacional,%20cuenca,%20aucas,quito&map=category-2,ft&operator=or"
                           id="navbarTienda"
                           target="_blank"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Tienda
                        </a>

                        <ul class="dropdown-menu shadow border-0" aria-labelledby="navbarTienda">
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Ubicaciones" asp-action="Index">
                                    Donde puedo encontrar camisetas ?
                                </a>
                            </li>

                            @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                            {
                                <li><hr class="dropdown-divider bg-secondary"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Ubicaciones" asp-action="Index">
                                        Gestionar Ubicaciones
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-uppercase fw-bold" href="#" id="navbarEscuelas" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Escuelas
                        </a>
                        <ul class="dropdown-menu shadow border-0" aria-labelledby="navbarEscuelas">
                            <li><a class="dropdown-item py-2" asp-controller="Escuelas" asp-action="Index" asp-route-region="Sierra">CDN SIERRA</a></li>
                            <li><hr class="dropdown-divider bg-secondary"></li>
                            <li><a class="dropdown-item py-2" asp-controller="Escuelas" asp-action="Index" asp-route-region="Costa">CDN COSTA</a></li>
                            <li><hr class="dropdown-divider bg-secondary"></li>
                            <li><a class="dropdown-item py-2" asp-controller="Escuelas" asp-action="Index" asp-route-region="Oriente">CDN ORIENTE</a></li>
                        </ul>
                    </li>
                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-uppercase fw-bold" href="#" id="navbarAdmin" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Administración
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow border-0" aria-labelledby="navbarAdmin">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="TablaPosiciones" asp-action="Index">
                                        <i class="fas fa-list-ol me-2"></i> Tabla de posiciones
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider bg-secondary"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Partidos" asp-action="Crear">
                                        <i class="fas fa-futbol me-2"></i> Partidos
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider bg-secondary"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Escuelas" asp-action="Create">
                                        <i class="fas fa-school me-2"></i> Escuelas
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <a class="nav-link btn-nav-socio m-0" asp-controller="Membresias" asp-action="Index">Hazte Socio</a>
                    <partial name="_LoginRegistroVistaParcial" />
                </div>
            </div>
        </div>
    </nav>

    @{
        bool esInicio = (ViewData["Title"]?.ToString()?.Contains("Inicio") ?? false);
    }

    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 pb-4 mt-5 border-top border-danger border-3">
        <div class="container text-center">

            <div class="row mb-5 text-center">
                <div class="col-12">
                    <h6 class="text-uppercase fw-bold mb-4" style="color: var(--nacional-rojo); letter-spacing: 2px;">Sponsors Oficiales</h6>

                    <div class="d-flex flex-wrap gap-4 justify-content-center align-items-center">

                        <a href="https://fibramax.ec/" target="_blank">
                            <img src="~/media/fibramax.png" alt="Fibramax" class="sponsor-img" style="height: 80px;">
                        </a>

                        <a href="https://medinuclear.com.ec/" target="_blank">
                            <img src="~/media/medi.png" alt="Medinuclear" class="sponsor-img" style="height: 150px;">
                        </a>

                        <a href="https://tecmanecuador.com/" target="_blank">
                            <img src="~/media/tecman.png" alt="Tecman" class="sponsor-img" style="height: 100px;">
                        </a>

                        <a href="https://proassislife.com/" target="_blank">
                            <img src="~/media/proassislife.png" alt="Proassislife" class="sponsor-img" style="height: 50px;">
                        </a>

                        <img src="~/media/lotto.png" alt="Lotto" class="sponsor-img" style="height: 120px;">

                    </div>
                </div>
            </div>

            <div class="row mb-5 text-center">
                <div class="col-12">
                    <h6 class="text-uppercase fw-bold mb-3" style="color: var(--nacional-gris);">Con el apoyo de</h6>
                    <a href="https://naniecheandia.com/inicio/" target="_blank">
                        <img src="~/media/NEF.png" alt="NEF" height="70" class="grayscale-logo">
                    </a>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <h6 class="text-uppercase fw-bold mb-4" style="color: var(--nacional-rojo);">Síguenos en redes</h6>
                    <div class="social-icons">
                        <a href="https://www.facebook.com/elnacionalecu" target="_blank" class="mx-3 text-white fs-2"><i class="bi bi-facebook"></i></a>
                        <a href="https://www.instagram.com/elnacionalec/" target="_blank" class="mx-3 text-white fs-2"><i class="bi bi-instagram"></i></a>
                        <a href="https://x.com/elnacionalec" target="_blank" class="mx-3 text-white fs-2"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://www.tiktok.com/@@elnacionalec" target="_blank" class="mx-3 text-white fs-2">
                            <i class="bi bi-tiktok"></i>
                        </a>
                    </div>
                </div>
            </div>

            <hr class="bg-secondary opacity-25">

            <div class="row">
                <div class="col-12">
                    <p class="small text-muted mb-0">&copy; 2026 Club Deportivo El Nacional - Todos los derechos reservados.</p>
                    <p class="small text-muted mb-0">
                        Detalles de Ubicación:
                        Sede Social/Administrativa: Calle Yasuní e Isla San Cristóbal, Quito, Ecuador, 170501.
                    </p>

                    <p class="small text-muted">Desarrollado para el Bitricampeón.</p>
                </div>
            </div>

        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>