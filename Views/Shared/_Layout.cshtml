<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - El Nacional</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">   
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="icon" type="image/png" href="~/media/escudo.png" />
    <link rel="apple-touch-icon" href="~/media/escudo.png" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        :root {
            --nacional-rojo: #DA291C;
            --nacional-azul: #0033A0;
            --nacional-gris: #A2AAAD;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f9fa;
        }

        /* NAVBAR PREMIUM */
        .navbar-custom {
            background: rgba(0, 0, 0, 0.8) !important; /* Fondo oscuro traslúcido */
            backdrop-filter: blur(15px); /* Efecto cristal esmerilado */
            -webkit-backdrop-filter: blur(15px);
            border-bottom: 2px solid var(--nacional-rojo);
            padding: 15px 0;
            transition: all 0.4s ease;
        }

        .navbar-brand img {
            transition: transform 0.3s ease;
        }

        .navbar-brand:hover img {
            transform: scale(1.1);
        }

        .nav-link {
            color: white !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            margin: 0 10px;
            position: relative;
            transition: color 0.3s ease;
        }

            /* Línea animada debajo de los links (EXCEPTO dropdown) */
            .nav-link:not(.dropdown-toggle)::after {
                content: '';
                position: absolute;
                width: 0;
                height: 2px;
                bottom: -5px;
                left: 0;
                background-color: var(--nacional-rojo);
                transition: width 0.3s ease;
            }

            .nav-link:not(.dropdown-toggle):hover::after {
                width: 100%;
            }

            .nav-link:hover {
                color: var(--nacional-rojo) !important;
            }

            /* Flecha del dropdown */
            .nav-link.dropdown-toggle::after {
                content: '' !important;
                position: static !important;
                display: inline-block !important;
                margin-left: 0.5em !important;
                vertical-align: 0.15em !important;
                width: auto !important;
                height: auto !important;
                border-top: 0.4em solid white !important;
                border-right: 0.4em solid transparent !important;
                border-bottom: 0 !important;
                border-left: 0.4em solid transparent !important;
                background-color: transparent !important;
                transition: border-top-color 0.3s ease !important;
            }

            /* Cambiar color de flecha en hover - sin animación de línea */
            .nav-link.dropdown-toggle:hover::after {
                border-top-color: var(--nacional-rojo) !important;
                width: auto !important;
            }

        /* Botón de Socio en el Nav */
        .btn-nav-socio {
            background-color: var(--nacional-rojo);
            color: white !important;
            border-radius: 50px;
            padding: 8px 20px !important;
            font-weight: 700 !important;
            box-shadow: 0 4px 15px rgba(218, 41, 28, 0.3);
        }

            .btn-nav-socio:hover {
                background-color: white;
                color: var(--nacional-rojo) !important;
                transform: translateY(-2px);
            }

        /* Para que no haya saltos de diseño */
        .main-content {
            min-height: 80vh;
        }

        /* Estilo para los links dentro del partial de login */
        .navbar-custom .login-partial-link {
            color: white !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            text-decoration: none;
            transition: color 0.3s;
        }

            .navbar-custom .login-partial-link:hover {
                color: var(--nacional-rojo) !important;
            }

        /* Separador visual entre Iniciar Sesión y Registro si están juntos */
        .auth-separator {
            color: rgba(255,255,255,0.3);
            margin: 0 5px;
        }

        /* Estilo para el menú desplegable */
        .dropdown-menu {
            background-color: #0033A0; /* Azul Nacional */
            border: none;
            border-top: 3px solid #DA291C; /* Línea superior Roja */
        }

        .dropdown-item {
            color: white !important;
            font-weight: 500;
            padding: 10px 20px;
            transition: all 0.3s;
        }

            .dropdown-item:hover {
                background-color: #DA291C; /* Fondo rojo al pasar el mouse */
                color: white !important;
                padding-left: 25px; /* Efecto sutil de movimiento */
            }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/media/escudo.png" height="50" alt="El Nacional">
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" href="#">Noticias</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">El Club</a></li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://www.kaosport.com/club-deportivo-el-nacional/nacional,%20cuenca,%20aucas,quito?_q=nacional,%20cuenca,%20aucas,quito&fuzzy=auto&initialMap=ft&initialQuery=nacional,%20cuenca,%20aucas,quito&map=category-2,ft&operator=or" target="_blank">
                            Tienda
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-uppercase fw-bold" href="#" id="navbarEscuelas" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Escuelas
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark shadow border-0" aria-labelledby="navbarEscuelas">
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Escuelas" asp-action="Index" asp-route-region="Sierra">CDN SIERRA</a>
                            </li>
                            <li><hr class="dropdown-divider bg-secondary"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Escuelas" asp-action="Index" asp-route-region="Costa">CDN COSTA</a>
                            </li>
                            <li><hr class="dropdown-divider bg-secondary"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Escuelas" asp-action="Index" asp-route-region="Oriente">CDN ORIENTE</a>
                            </li>
                        </ul>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <a class="nav-link btn-nav-socio m-0" href="#">Hazte Socio</a>
                    <partial name="_LoginRegistroVistaParcial" />
                </div>
            </div>
        </div>
    </nav>

    @{
        bool esInicio = (ViewData["Title"]?.ToString()?.Contains("Inicio") ?? false);
    }

    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white py-5 mt-5">
        <div class="container text-center">
            <img src="~/media/escudo.png" height="60" class="mb-3 grayscale" style="filter: brightness(0) invert(1); opacity: 0.5;">
            <p class="small text-muted">&copy; 2026 Club Deportivo El Nacional - Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>