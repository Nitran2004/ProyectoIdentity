        }

        /* BANNER DE PARTIDO (Full Width también) */
        .match-banner {
            width: 100%;
            background-color: var(--nacional-azul);
            color: white;
            padding: 40px 0;
            margin: 0;
        }

        /* Botones (Rojo Nacional) */
        .btn-rojo {
            background-color: #DA291C;
            color: white;
            padding: 12px 30px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            margin-top: 20px;
        }

        .btn-nacional {
            background-color: #DA291C;
            color: white;
            padding: 8px 30px; /* Ajustado para nivelar con el botón de borde */
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            border: 2px solid #DA291C; /* Grosor igual al del botón outline */
