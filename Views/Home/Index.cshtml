<section class="match-banner py-5" style="background: linear-gradient(180deg, #0a0a0a 0%, #1a1a1a 100%);">
    <div class="container">
        @if (Model.ProximoPartido != null)
        {
            <div class="row text-center mb-4">
                <div class="col-md-12">
                    <h5 class="text-uppercase fw-bold" style="letter-spacing: 3px; color: #69b3e7;">
                        PRÓXIMO PARTIDO - LIGAPRO
                    </h5>
                </div>
            </div>

            <div class="match-content d-flex justify-content-center align-items-center flex-wrap gap-4">
                <div class="d-flex align-items-center">
                    <span class="display-5 mb-0 me-3 fw-black text-white text-uppercase">@Model.ProximoPartido.Local</span>
                    @if (Model.ProximoPartido.ImagenLocal != null)
                    {
                        <img style="width: 120px; height: 120px; object-fit: contain;"
                             src="data:image/png;base64,@Convert.ToBase64String(Model.ProximoPartido.ImagenLocal)" />
                    }
                </div>

                <div class="match-info px-4 text-center">
                    <div class="vs-text fw-black" style="font-size: 3rem; color: #DA291C;">VS</div>
                    <div class="text-white-50">
                        <i class="bi bi-calendar-event"></i> @Model.ProximoPartido.FechaHora.ToString("dddd dd MMMM, HH:mm")
                    </div>
                    <div class="text-warning fw-bold">
                        <i class="bi bi-geo-alt"></i> @Model.ProximoPartido.Estadio
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    @if (Model.ProximoPartido.ImagenVisitante != null)
                    {
                        <img style="width: 120px; height: 120px; object-fit: contain;"
                             src="data:image/png;base64,@Convert.ToBase64String(Model.ProximoPartido.ImagenVisitante)" />
                    }
                    <span class="display-5 mb-0 ms-3 fw-black text-white text-uppercase">@Model.ProximoPartido.Visitante</span>
                </div>
            </div>

            <div class="row mt-5">
                <div class="col-12 text-center">
                    @if (!string.IsNullOrEmpty(Model.ProximoPartido.EntradasLink))
                    {
                        <a href="@Model.ProximoPartido.EntradasLink" target="_blank"
                           class="btn btn-danger btn-lg px-5 py-3 fw-bold text-uppercase shadow-lg"
                           style="border-radius: 50px; font-size: 1.2rem; transition: transform 0.3s;">
                            <i class="bi bi-ticket-perforated-fill me-2"></i> Comprar Entradas
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg px-5 py-3 disabled"
                                style="border-radius: 50px; font-size: 1.2rem; opacity: 0.8;">
                            <i class="bi bi-info-circle me-2"></i>
                            @if (Model.ProximoPartido.Visitante.Contains("Nacional"))
                            {
                                @:Visitante - No disponible
                            }
                            else
                            {
                                @:Entradas no disponibles
                            }
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="py-5 text-center">
                <p class="h4 text-white-50">No hay partidos programados en este momento</p>
            </div>
        }
    </div>
</section>
