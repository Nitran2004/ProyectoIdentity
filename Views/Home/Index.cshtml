        /* SECCIÓN BI-TRI */
/* SECCION BI-TRI - REEMPLAZO COMPLETO */
.bitri-section {
    position: relative;
    /* Ajustamos el alto para que quepan bien las dos filas */
    min-height: 700px; 
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: #000;
    margin: 0;
    padding: 0;
}

/* Grid de 6 fotos de fondo */
.bitri-bg-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: grid;
    /* 3 columnas de igual tamanio */
    grid-template-columns: repeat(3, 1fr); 
    /* 2 filas de igual tamanio */
    grid-template-rows: repeat(2, 1fr); 
    z-index: 0;
}

.bg-item {
    width: 100%;
    height: 100%; /* Obliga al div a llenar su celda del grid */
    overflow: hidden;
}

.bg-item img {
    width: 100%;
    height: 100%;
    /* CLAVE: Hace que la imagen cubra todo el espacio sin deformarse */
    object-fit: cover; 
    filter: grayscale(100%) brightness(35%);
    display: block;
}

/* Capa de color para el efecto Bi-Tri */
.bitri-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Gradiente con los colores del club */
    background: linear-gradient(45deg, rgba(0, 51, 160, 0.6), rgba(218, 41, 28, 0.4));
    z-index: 1;
    pointer-events: none;
}

/* Asegura que el contenido (trofeos, texto) flote sobre el fondo */
.bitri-content {
    position: relative;
    z-index: 5;
    width: 100%;
    color: white;
}

/* Responsive: En celulares es mejor verlas en 2 columnas */
@@media (max-width: 768px) {
    .bitri-bg-grid {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(3, 1fr);
    }
    .bitri-section {
        min-height: 500px;
    }
}

        /* Grid de Trofeos 2x3 */
