@model ProyectoIdentity.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Inicio - El Nacional";
    Layout = "_Layout";
}


@section Styles {
    <style>
        /* Forzamos al body y html a no tener margenes */
        body, html {
            margin: 0;
            padding: 0;
            overflow-x: hidden; /* Evita el scroll horizontal */
            width: 100%;
        }

        /* Forzamos al contenedor principal a ignorar cualquier ancho máximo */
        .container-fluid.p-0,
        .main-content,
        main[role="main"] {
            max-width: 100% !important;
            width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

        .hero-video {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100%;
            min-height: 100%;
            width: 100%; /* Forzamos ancho */
            height: 100%; /* Forzamos alto */
            object-fit: cover; /* Recorta el video para llenar el espacio sin deformar */
            z-index: 0;
        }

        /* HERO SECTION CORREGIDA */
        .hero-section {
            position: relative;
            width: 100%;
            height: 100vh;
            background-color: #000;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .match-banner {
            background-color: #0033A0; /* Azul El Nacional */
            color: white;
            padding: 30px 0;
        }

        .match-content {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
        }

        .team-logo {
            height: 70px;
            filter: drop-shadow(2px 2px 5px rgba(0,0,0,0.3));
        }

        .vs-text {
            font-size: 2rem;
            font-weight: 900;
            color: #DA291C; /* Rojo */
        }

        .hero-video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            transform: translate(-50%, -50%);
            object-fit: cover; /* CLAVE: Estira el video para cubrir todo */
            z-index: 0;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.2), rgba(218, 41, 28, 0.4));
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: white;
            padding: 0 20px;
        }

        /* Títulos */
        .titulo-bi-tri {
            font-size: clamp(2.5rem, 8vw, 5rem); /* Se ajusta al tamaño de pantalla */
            font-weight: 900;
            text-transform: uppercase;
            text-shadow: 0px 4px 15px rgba(0,0,0,0.8);
        }

        /* BANNER DE PARTIDO (Full Width también) */
        .match-banner {
            width: 100%;
            background-color: var(--nacional-azul);
            color: white;
            padding: 40px 0;
            margin: 0;
        }

        /* Botones (Rojo Nacional) */
        .btn-rojo {
            background-color: #DA291C;
            color: white;
            padding: 12px 30px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            margin-top: 20px;
        }

        .btn-nacional {
            background-color: #DA291C;
            color: white;
            padding: 8px 30px; /* Ajustado para nivelar con el botón de borde */
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            border: 2px solid #DA291C; /* Grosor igual al del botón outline */
            display: inline-block;
            transition: 0.3s;
        }

            .btn-nacional:hover {
                background-color: #b31d14;
                border-color: #b31d14;
                color: white;
                transform: scale(1.05);
            }

            /* SECCIÓN DE SOCIOS */
.membership-section {
    position: relative;
    padding: 100px 0;
    min-height: 80vh;
    overflow: hidden;
    color: white;
}

.membership-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-attachment: fixed; /* Efecto Parallax */
    z-index: -2;
}

.membership-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(0, 51, 160, 0.95) 0%, rgba(0, 0, 0, 0.6) 100%);
    z-index: -1;
}

.text-rojo {
    color: var(--nacional-rojo);
}

.benefit-item {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
}

.benefit-icon {
    font-size: 1.5rem;
    color: var(--nacional-rojo);
    padding-top: 5px;
}

.benefit-content h4 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 5px;
}

.benefit-content p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
}

/* Botón Estilo Referencia */
.btn-membership {
    display: inline-block;
    background-color: var(--nacional-rojo);
    color: white;
    text-decoration: none;
    padding: 15px 40px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    border-radius: 4px; /* Un poco más cuadrado como la referencia */
}

.btn-membership:hover {
    background-color: white;
    color: var(--nacional-rojo);
    transform: translateY(-5px);
}

/* Visual a la derecha */
.membership-card-visual {
    position: relative;
    text-align: center;
}

.floating-img {
    filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5));
    animation: float 6s ease-in-out infinite;
}

.card-glass-effect {
    position: absolute;
    bottom: -20px;
    left: 10%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 20px;
    border-radius: 15px;
    width: 80%;
}

keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0px); }
}
    </style>
}

<header class="hero-section">
    <video class="hero-video" autoplay muted loop playsinline poster="/images/poster-frame.jpg">
        <source src="~/media/inicial.mp4" type="video/mp4">
        Tu navegador no soporta video HTML5.
    </video>

    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1 class="titulo-bi-tri">La Gloria del Fútbol</h1>
        <p class="mt-3 text-light h5">La Máquina Gris | Puros Criollos</p>

        <div class="d-flex justify-content-center align-items-center gap-3">
            <a href="https://www.superticket.ec/equipos/cd-nacional" target="_blank" class="btn-nacional m-0">
                Comprar Entradas
            </a>

            <a asp-controller="Membresias"
               asp-action="Index"
               class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold m-0">
                Hazte Socio
            </a>
        </div>
    </div>
</header>

<section class="membership-section">
    <div class="membership-bg" style="background-image: url('/media/nac1.png');"></div>
    <div class="membership-overlay"></div>

    <div class="container membership-container">
        <div class="row align-items-center">
            <div class="col-lg-6 membership-text">
                <h2 class="display-4 fw-bold mb-4">ÚNETE AL <span class="text-rojo">BI-TRI</span></h2>
                <h3 class="h4 mb-5">HAZTE SOCIO HOY</h3>

                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fas fa-shield-alt"></i></div>
                    <div class="benefit-content">
                        <h4>Identidad Pura</h4>
                        <p>Sé parte de la historia del único Bi-tri campeon del futbol ecuatoriano. Forma parte de la pasión y orgullo de la "Máquina Gris".</p>
                    </div>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fas fa-star"></i></div>
                    <div class="benefit-content">
                        <h4>Beneficios Exclusivos</h4>
                        <p>Acceso preferencial a entradas, descuentos en Kao Sports y eventos especiales.</p>
                    </div>
                </div>

                <a href="#" class="btn-membership mt-4">
                    QUIERO SER SOCIO <i class="fas fa-chevron-right ms-2"></i>
                </a>
            </div>

            <div class="col-lg-6 d-none d-lg-block">
                <div class="membership-card-visual">
                    <img src="~/media/jugador-socio.png" alt="Socio El Nacional" class="img-fluid floating-img">
                    <div class="card-glass-effect">
                        <img src="~/media/escudo.png" height="80" alt="Escudo">
                        <p class="mt-3 fw-bold">MEMBRESÍA DIGITAL OFICIAL</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="match-banner">
    <div class="container">
        @if (Model.ProximoPartido != null)
        {
            <div class="row align-items-center text-center">
                <div class="col-md-12">
                    <h5 class="text-uppercase mb-3" style="letter-spacing: 1px; color: #69b3e7;">
                        Próximo Encuentro - LigaPro
                    </h5>
                </div>
            </div>

            <div class="match-content">
                <div class="d-flex align-items-center">
                    <span class="h3 mb-0 me-3 fw-bold">@Model.ProximoPartido.Local</span>

                    @if (Model.ProximoPartido.ImagenLocal != null)
                    {
                        <img class="team-logo"
                             src="data:image/png;base64,@Convert.ToBase64String(Model.ProximoPartido.ImagenLocal)" />
                    }
                </div>

                <div class="match-info">
                    <div class="vs-text">VS</div>
                    <small class="d-block mt-1">
                        @Model.ProximoPartido.FechaHora.ToString("dddd dd, HH:mm")
                    </small>
                    <small class="d-block text-warning">
                        @Model.ProximoPartido.Estadio
                    </small>
                </div>

                <div class="d-flex align-items-center">
                    @if (Model.ProximoPartido.ImagenVisitante != null)
                    {
                        <img class="team-logo"
                             src="data:image/png;base64,@Convert.ToBase64String(Model.ProximoPartido.ImagenVisitante)" />
                    }

                    <span class="h3 mb-0 ms-3 fw-bold">@Model.ProximoPartido.Visitante</span>
                </div>
            </div>
        }
        else
        {
            <p class="text-center text-white">No hay partidos programados</p>
        }
    </div>
</section>


<div class="container my-5">
    <h2 class="text-center mb-4" style="color:#0033A0;">Tabla de posiciones</h2>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Pos</th>
                    <th class="text-center">Escudo</th>
                    <th>Club</th>
                    <th>Puntos</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Tabla)
                {
                    <tr>
                        <td class="fw-bold">@item.Posicion</td>
                        <td class="text-center">
                            @if (item.ImagenClub != null && item.ImagenClub.Length > 0)
                            {
                                <img src="data:image/png;base64,@Convert.ToBase64String(item.ImagenClub)" height="30" />
                            }
                        </td>
                        <td>@item.Club</td>
                        <td class="fw-bold">@item.Puntos</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>


<div class="container my-5">
    <h2 class="text-center mb-4" style="color: #0033A0;">Últimas Noticias</h2>
    <p class="text-center">Aquí iría el grid de noticias...</p>
</div>