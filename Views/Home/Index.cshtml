@model ProyectoIdentity.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Inicio - El Nacional";
    Layout = "_Layout";
}


@section Styles {
    <style>
        /* Forzamos al body y html a no tener margenes */
        body, html {
            margin: 0;
            padding: 0;
            overflow-x: hidden; /* Evita el scroll horizontal */
            width: 100%;
        }

        /* Forzamos al contenedor principal a ignorar cualquier ancho máximo */
        .container-fluid.p-0,
        .main-content,
        main[role="main"] {
            max-width: 100% !important;
            width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

        .hero-video {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100%;
            min-height: 100%;
            width: 100%; /* Forzamos ancho */
            height: 100%; /* Forzamos alto */
            object-fit: cover; /* Recorta el video para llenar el espacio sin deformar */
            z-index: 0;
        }

        /* HERO SECTION CORREGIDA */
        .hero-section {
            position: relative;
            width: 100%;
            height: 100vh;
            background-color: #000;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .match-banner {
            background-color: #0033A0; /* Azul El Nacional */
            color: white;
            padding: 30px 0;
        }

        .match-content {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
        }

        .team-logo {
            height: 70px;
            filter: drop-shadow(2px 2px 5px rgba(0,0,0,0.3));
        }

        .vs-text {
            font-size: 2rem;
            font-weight: 900;
            color: #DA291C; /* Rojo */
        }

        .hero-video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            transform: translate(-50%, -50%);
            object-fit: cover; /* CLAVE: Estira el video para cubrir todo */
            z-index: 0;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.2), rgba(218, 41, 28, 0.4));
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: white;
            padding: 0 20px;
        }

        /* Títulos */
        .titulo-bi-tri {
            font-size: clamp(2.5rem, 8vw, 5rem); /* Se ajusta al tamaño de pantalla */
            font-weight: 900;
            text-transform: uppercase;
            text-shadow: 0px 4px 15px rgba(0,0,0,0.8);
        }

        /* BANNER DE PARTIDO (Full Width también) */
        .match-banner {
            width: 100%;
            background-color: var(--nacional-azul);
            color: white;
            padding: 40px 0;
            margin: 0;
        }

        /* Botones (Rojo Nacional) */
        .btn-rojo {
            background-color: #DA291C;
            color: white;
            padding: 12px 30px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            margin-top: 20px;
        }

        .btn-nacional {
            background-color: #DA291C;
            color: white;
            padding: 8px 30px; /* Ajustado para nivelar con el botón de borde */
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            border: 2px solid #DA291C; /* Grosor igual al del botón outline */
            display: inline-block;
            transition: 0.3s;
        }

            .btn-nacional:hover {
                background-color: #b31d14;
                border-color: #b31d14;
                color: white;
                transform: scale(1.05);
            }

            /* SECCIÓN DE SOCIOS */
.membership-section {
    position: relative;
    padding: 100px 0;
    min-height: 80vh;
    overflow: hidden;
    color: white;
}

.membership-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: contain;
    background-position: center;
            background-attachment: scroll; /* Efecto Parallax */
    z-index: -2;
}

.membership-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(0, 51, 160, 0.95) 0%, rgba(0, 0, 0, 0.6) 100%);
    z-index: -1;
}

.text-rojo {
    color: var(--nacional-rojo);
}

.benefit-item {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
}

.benefit-icon {
    font-size: 1.5rem;
    color: var(--nacional-rojo);
    padding-top: 5px;
}

.benefit-content h4 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 5px;
}

.benefit-content p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
}

/* Botón Estilo Referencia */
.btn-membership {
    display: inline-block;
    background-color: var(--nacional-rojo);
    color: white;
    text-decoration: none;
    padding: 15px 40px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    border-radius: 4px; /* Un poco más cuadrado como la referencia */
}

.btn-membership:hover {
    background-color: white;
    color: var(--nacional-rojo);
    transform: translateY(-5px);
}

/* Visual a la derecha */
.membership-card-visual {
    position: relative;
    text-align: center;
}

.floating-img {
    filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5));
    animation: float 6s ease-in-out infinite;
}

        .card-glass-effect {
            position: relative;
            left: auto;
            bottom: auto;
            width: 100%;
            max-width: 460px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.22);
            padding: 22px;
            border-radius: 18px;
        }


keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0px); }
}


        .tarjeta {
            width: 320px;
            border-radius: 18px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.45);
            margin: 0 auto 20px auto;
            display: block;
            overflow: hidden;
            position: relative;
        }

        /* Tarjeta física */
        .tarjeta-fisica {
            transform: rotate(-4deg);
            border: 2px solid rgba(255,255,255,0.25);
        }

        /* Tarjeta digital */
        .tarjeta-digital {
            background: linear-gradient(135deg, #b31217, #8b0000);
            color: white;
            padding: 20px;
            font-family: 'Arial', sans-serif;
            transform: rotate(2deg);
            border: 2px solid rgba(255,255,255,0.25);
        }

        /* Header */
        .tarjeta-header {
            font-size: 0.75rem;
            letter-spacing: 2px;
            display: flex;
            justify-content: space-between;
            opacity: 0.85;
        }

        /* Cuerpo */
        .tarjeta-body {
            margin-top: 25px;
        }

        .tarjeta-nombre {
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .tarjeta-numero {
            margin-top: 6px;
            font-size: 0.9rem;
            opacity: 0.85;
        }

        .tarjeta-vip {
            margin-top: 10px;
            display: inline-block;
            background: gold;
            color: black;
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 0.75rem;
        }

        /* Footer */
        .tarjeta-footer {
            margin-top: 20px;
            font-size: 0.7rem;
            display: flex;
            justify-content: space-between;
            opacity: 0.75;
        }
        /* TARJETA DIGITAL PREMIUM */
        .tarjeta-digital-premium {
            width: 100%;
            max-width: 420px;
            min-height: 240px;
            height: auto;
            border-radius: 22px;
            padding: 22px;
            color: white;
            background: linear-gradient(135deg, #b31217, #8b0000, #da291c);
            box-shadow: 0 25px 60px rgba(0,0,0,0.55);
            border: 2px solid rgba(255,255,255,0.25);
            position: relative;
            overflow: hidden;
            transform: rotate(2deg);
            display: flex;
            flex-direction: column;
        }

            .tarjeta-digital-premium::before {
                content: "";
                position: absolute;
                inset: -60%;
                background: linear-gradient(120deg, rgba(255,255,255,0.12), transparent 60%);
                transform: rotate(25deg);
                pointer-events: none;
                z-index: 1;
                opacity: 0.35;
            }

            .tarjeta-digital-premium > * {
                position: relative;
                z-index: 2;
            }

        .tarjeta-medio {
            margin-top: 18px;
        }

        .tarjeta-bottom {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }


            /* Brillo tipo tarjeta bancaria */
            .tarjeta-digital-premium::before {
                content: "";
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(120deg, rgba(255,255,255,0.15), transparent 60%);
                transform: rotate(25deg);
            }

        /* Parte superior */
        .tarjeta-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .tarjeta-escudo {
            height: 60px;
            filter: drop-shadow(0 6px 12px rgba(0,0,0,0.6));
        }

        .tarjeta-socio-texto {
            font-size: 0.75rem;
            letter-spacing: 3px;
            opacity: 0.85;
        }

        /* Parte central */
        .tarjeta-medio {
            margin-top: 18px;
        }

        .tarjeta-nombre {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .tarjeta-numero {
            margin-top: 8px;
            font-size: 1rem;
            letter-spacing: 3px;
            opacity: 0.9;
        }

        /* Parte inferior */
        .tarjeta-bottom {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }


        .tarjeta-vip {
            background: gold;
            color: black;
            padding: 6px 14px;
            border-radius: 10px;
            font-weight: 900;
            font-size: 0.75rem;
            box-shadow: 0 6px 12px rgba(0,0,0,0.4);
        }

        .tarjeta-expira {
            font-size: 0.8rem;
            opacity: 0.85;
        }
        /* Texto del club */
        .tarjeta-club {
            font-size: 0.85rem;
            letter-spacing: 2px;
            font-weight: 700;
            line-height: 1.1;
            text-transform: uppercase;
            opacity: 0.9;
        }

            .tarjeta-club span {
                font-size: 1.2rem;
                font-weight: 900;
                letter-spacing: 3px;
            }

        /* Membresía */
        .tarjeta-membresia {
            display: flex;
            flex-direction: column;
            gap: 6px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.75rem;
            opacity: 0.95;
        }

            .tarjeta-membresia span {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: fit-content;
                padding: 7px 14px;
                border-radius: 999px;
                font-size: 0.85rem;
                font-weight: 900;
                letter-spacing: 1px;
                color: #111;
                background: linear-gradient(135deg, #f6d365, #fda085);
                box-shadow: 0 10px 20px rgba(0,0,0,0.35);
                border: 1px solid rgba(255,255,255,0.35);
            }

        .tarjeta-digital-premium::before {
            opacity: 0.55;
        }


        /* Expiración */
        .tarjeta-expira {
            font-size: 0.75rem;
            letter-spacing: 1px;
            opacity: 0.85;
            text-align: right;
        }

        .tarjeta-digital-premium {
            width: 100%;
            max-width: 420px;
            height: 250px;
            border-radius: 22px;
            padding: 22px;
            color: white;
            background: linear-gradient(135deg, #b31217, #8b0000, #da291c);
            box-shadow: 0 25px 60px rgba(0,0,0,0.55);
            border: 2px solid rgba(255,255,255,0.25);
            position: relative;
            overflow: hidden;
            transform: rotate(2deg);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .tarjeta-digital-premium::before {
                content: "";
                position: absolute;
                inset: -60%;
                background: linear-gradient(120deg, rgba(255,255,255,0.14), transparent 60%);
                transform: rotate(25deg);
                pointer-events: none;
                z-index: 1;
            }

            .tarjeta-digital-premium > * {
                position: relative;
                z-index: 2;
            }

        .tarjeta-fisica {
            width: 100%;
            max-width: 360px;
            border-radius: 18px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.45);
            display: block;
            margin: 0 auto 14px auto;
            transform: rotate(-4deg);
            border: 2px solid rgba(255,255,255,0.25);
        }

        .texto-apoyo {
            margin-top: 10px;
            text-align: center;
            font-size: 0.95rem;
            color: rgba(255,255,255,0.9);
        }

        .membership-text {
    padding-left: 210px;
}

media (max-width: 991px) {
    .membership-text {
        padding-left: 20px;
        padding-right: 20px;
        text-align: center;
    }
}

        .membership-container {
            max-width: 1250px;
        }


    </style>
}

<header class="hero-section">
    <video class="hero-video" autoplay muted loop playsinline poster="/images/poster-frame.jpg">
        <source src="~/media/inicial.mp4" type="video/mp4">
        Tu navegador no soporta video HTML5.
    </video>

    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1 class="titulo-bi-tri">La Gloria del Fútbol</h1>
        <p class="mt-3 text-light h5">La Máquina Gris | El Único Bi Tricampeón</p>

        <div class="d-flex justify-content-center align-items-center gap-3">
            <a href="https://www.superticket.ec/equipos/cd-nacional" target="_blank" class="btn-nacional m-0">
                Comprar Entradas
            </a>

            <a asp-controller="Membresias"
               asp-action="Index"
               class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold m-0">
                Hazte Socio
            </a>
        </div>
    </div>
</header>

<section class="membership-section">
    <div class="membership-bg" style="background-image: url('/media/nac1.png');"></div>
    <div class="membership-overlay"></div>

    <div class="row align-items-center">
        <div class="col-lg-6 membership-text">
            <h2 class="display-4 fw-bold mb-4">ÚNETE AL <span class="text-rojo">BI-TRI</span></h2>
            <h3 class="h4 mb-5">HAZTE SOCIO HOY</h3>

            <div class="benefit-item">
                <div class="benefit-icon"><i class="fas fa-shield-alt"></i></div>
                <div class="benefit-content">
                    <h4>Identidad Pura</h4>
                    <p>Sé parte de la historia del único Bi-tri campeon del futbol ecuatoriano. Forma parte de la pasión y orgullo de la "Máquina Gris".</p>
                </div>
            </div>

            <div class="benefit-item">
                <div class="benefit-icon"><i class="fas fa-star"></i></div>
                <div class="benefit-content">
                    <h4>Beneficios Exclusivos</h4>
                    <p>Acceso preferencial a entradas, descuentos en Kao Sports y eventos especiales.</p>
                </div>
            </div>

            <a href="#" class="btn-membership mt-4">
                QUIERO SER SOCIO <i class="fas fa-chevron-right ms-2"></i>
            </a>
        </div>

        <div class="col-lg-6 d-flex justify-content-center">
            <div class="card-glass-effect">

                <img src="~/media/socio.png" class="tarjeta-fisica" alt="Tarjeta física El Nacional">
                <p class="mt-2 fw-bold text-center">MEMBRESÍA FÍSICA OFICIAL</p>

                <div class="tarjeta-digital-premium">

                    <div class="tarjeta-top">
                        <div class="tarjeta-club">
                            CLUB DEPORTIVO<br>
                            <span>EL NACIONAL</span>
                        </div>
                        <img src="~/media/digital.png" class="tarjeta-escudo" alt="Escudo El Nacional">
                    </div>

                    <div class="tarjeta-medio">
                        <div class="tarjeta-nombre">JUAN PÉREZ GARCÍA</div>
                        <div class="tarjeta-numero">1234 5678 9000</div>
                    </div>

                    <div class="tarjeta-bottom">
                        <div class="tarjeta-membresia">
                            TIPO DE MEMBRESÍA
                            <span>VIP</span>
                        </div>

                        <div class="tarjeta-expira">
                            VENCE<br>
                            <strong>NOV / 2025</strong>
                        </div>
                    </div>

                </div>

                <p class="mt-3 fw-bold text-center">MEMBRESÍA DIGITAL OFICIAL</p>
                <div class="texto-apoyo">Si seleccionas digital estás ayudando al club</div>

            </div>
        </div>
    </div>

</section>

<section class="match-banner">
    <div class="container">
        @if (Model.ProximoPartido != null)
        {
            <div class="row align-items-center text-center">
                <div class="col-md-12">
                    <h5 class="text-uppercase mb-3" style="letter-spacing: 1px; color: #69b3e7;">
                        Próximo Encuentro - LigaPro
                    </h5>
                </div>
            </div>

            <div class="match-content">
                <div class="d-flex align-items-center">
                    <span class="h3 mb-0 me-3 fw-bold">@Model.ProximoPartido.Local</span>

                    @if (Model.ProximoPartido.ImagenLocal != null)
                    {
                        <img class="team-logo"
                             src="data:image/png;base64,@Convert.ToBase64String(Model.ProximoPartido.ImagenLocal)" />
                    }
                </div>

                <div class="match-info">
                    <div class="vs-text">VS</div>
                    <small class="d-block mt-1">
                        @Model.ProximoPartido.FechaHora.ToString("dddd dd, HH:mm")
                    </small>
                    <small class="d-block text-warning">
                        @Model.ProximoPartido.Estadio
                    </small>
                </div>

                <div class="d-flex align-items-center">
                    @if (Model.ProximoPartido.ImagenVisitante != null)
                    {
                        <img class="team-logo"
                             src="data:image/png;base64,@Convert.ToBase64String(Model.ProximoPartido.ImagenVisitante)" />
                    }

                    <span class="h3 mb-0 ms-3 fw-bold">@Model.ProximoPartido.Visitante</span>
                </div>
            </div>
        }
        else
        {
            <p class="text-center text-white">No hay partidos programados</p>
        }
    </div>
</section>


<div class="container my-5">
    <h2 class="text-center mb-4" style="color:#0033A0;">Tabla de posiciones</h2>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Pos</th>
                    <th class="text-center">Escudo</th>
                    <th>Club</th>
                    <th>Puntos</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Tabla)
                {
                    <tr>
                        <td class="fw-bold">@item.Posicion</td>
                        <td class="text-center">
                            @if (item.ImagenClub != null && item.ImagenClub.Length > 0)
                            {
                                <img src="data:image/png;base64,@Convert.ToBase64String(item.ImagenClub)" height="30" />
                            }
                        </td>
                        <td>@item.Club</td>
                        <td class="fw-bold">@item.Puntos</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>


<div class="container my-5">
    <h2 class="text-center mb-4" style="color: #0033A0;">Últimas Noticias</h2>
    <p class="text-center">Aquí iría el grid de noticias...</p>
</div>