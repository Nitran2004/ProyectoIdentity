            font-size: 13px;
            font-weight: bold;
            color: #333;
            height: 40px;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .price-prefix {
            font-size: 11px;
            color: #888;
            margin-bottom: 0;
        }

        .price-value {
            font-size: 20px;
            font-weight: 800;
            color: #006437; /* Verde El Nacional */
            margin-bottom: 10px;
        }

        .btn-buy-now {
            background-color: #006437;
            color: white;
            border: none;
            padding: 8px 25px;
            font-weight: bold;
            font-size: 12px;
            width: 100%;
            border-radius: 4px;
        }

        /* Botones de Navegación Personalizados */
        .swiper-button-prev-custom,
        .swiper-button-next-custom {
            position: absolute;
            top: 40%;
            z-index: 10;
            font-size: 2rem;
            color: #006437;
            cursor: pointer;
            transition: color 0.3s;
        }

        .swiper-button-prev-custom {
            left: 0px;
        }

        .swiper-button-next-custom {
            right: 0px;
        }

            .swiper-button-prev-custom:hover,
            .swiper-button-next-custom:hover {
                color: #e30613; /* Rojo El Nacional al pasar el mouse */
            }

        /* Banner Promocional Lateral */
        .promo-banner-bi-tri {
            background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/media/fondo_banner.jpg');
            background-size: cover;
            background-position: center;
            height: 100%;
            min-height: 400px;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 20px;
            text-align: center;
            color: white;
        }

        .promo-shield {
            width: 60px;
            margin-bottom: 20px;
        }

        .promo-phrase {
            font-weight: bold;
            font-size: 1.2rem;
            line-height: 1.4;
            margin-bottom: 30px;
        }

        .btn-promo-buy {
            background-color: #f8f9fa;
            color: #333;
            border: none;
            padding: 10px 30px;
            font-weight: bold;
            border-radius: 5px;
        }

        /* Contenedor estrecho para centrar la tienda */
        .container-narrow {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

        .promo-banner-sidebar {
            height: 450px;
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 15px;
        }

        .promo-shield-small {
            width: 100%; /* ← Imagen ocupa todo el banner */
            height: 100%;
            object-fit: cover; /* ← Recorta sin deformar */
            position: absolute;
            top: 0;
            left: 0;
            z-index: 0;
            opacity: 0.7;
        }

        .promo-content-inner {
            position: relative;
            z-index: 1; /* ← Texto encima de la imagen */
        }

        .swiper-button-prev-custom,
        .swiper-button-next-custom {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            font-size: 2rem;
            color: #006437;
            cursor: pointer;
            transition: color 0.3s;
        }

        .swiper-button-prev-custom {
            left: -15px;
        }

        .swiper-button-next-custom {
            right: -15px;
        }

            .swiper-button-prev-custom:hover,
            .swiper-button-next-custom:hover {
                color: #DA291C;
            }

        .swiper-productos {
            position: relative;
            padding: 0 40px;
        }

        .hero-video-mobile {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            z-index: 0;
        }
    </style>

    

}

