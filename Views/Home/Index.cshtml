@model ProyectoIdentity.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Inicio - El Nacional";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

@section Styles {
    <style>
        /* Forzamos al body y html a no tener margenes */
        body, html {
            margin: 0;
            padding: 0;
            overflow-x: hidden; /* Evita el scroll horizontal */
            width: 100%;
        }

        /* Forzamos al contenedor principal a ignorar cualquier ancho máximo */
        .container-fluid.p-0,
        .main-content,
        main[role="main"] {
            max-width: 100% !important;
            width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

        .hero-video {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100%;
            min-height: 100%;
            width: 100%; /* Forzamos ancho */
            height: 100%; /* Forzamos alto */
            object-fit: cover; /* Recorta el video para llenar el espacio sin deformar */
            z-index: 0;
        }

        /* HERO SECTION CORREGIDA */
        .hero-section {
            position: relative;
            width: 100%;
            height: 100vh;
            background-color: #000;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .match-banner {
            background-color: #0033A0; /* Azul El Nacional */
            color: white;
            padding: 30px 0;
        }

        .match-content {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
        }

        .team-logo {
            height: 70px;
            filter: drop-shadow(2px 2px 5px rgba(0,0,0,0.3));
        }

        .vs-text {
            font-size: 2rem;
            font-weight: 900;
            color: #DA291C; /* Rojo */
        }


        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.2), rgba(218, 41, 28, 0.4));
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: white;
            padding: 0 20px;
        }

        /* Títulos */
        .titulo-bi-tri {
