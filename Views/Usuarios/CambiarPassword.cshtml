@model CambiarPasswordViewModel

@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUsuario> UserManager;

@{
    ViewData["Title"] = "Cambiar contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Cambiar contraseña</h1>

<form asp-controller="Usuarios" asp-action="CambiarPassword" method="post" role="form">
    <div class="text-danger" asp-validation-summary="All"></div>

    <!-- CONTRASEÑA ACTUAL -->
    <div class="form-group">
        <label asp-for="PasswordActual" class="col-md-2"></label>
        <div class="col-md-10 position-relative">
            <input asp-for="PasswordActual" type="password" class="form-control" id="PasswordActual" />
            <span asp-validation-for="PasswordActual" class="text-danger"></span>
            <button type="button" id="togglePasswordActual" class="password-toggle"
                    style="position:absolute; right:30px; top:50%; transform:translateY(-50%);">
                <i class="bi bi-eye-slash"></i>
            </button>
        </div>
    </div>

    <!-- NUEVA CONTRASEÑA -->
    <div class="form-group">
        <label asp-for="Password" class="col-md-2"></label>
        <div class="col-md-10 position-relative">
            <input asp-for="Password" type="password" class="form-control" id="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <button type="button" id="togglePassword" class="password-toggle"
                    style="position:absolute; right:30px; top:50%; transform:translateY(-50%);">
                <i class="bi bi-eye-slash"></i>
            </button>
        </div>
    </div>

    <!-- CONFIRMAR CONTRASEÑA -->
    <div class="form-group">
        <label asp-for="ConfirmPassword" class="col-md-2"></label>
        <div class="col-md-10 position-relative">
            <input asp-for="ConfirmPassword" type="password" class="form-control" id="ConfirmPassword" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <button type="button" id="toggleConfirmPassword" class="password-toggle"
                    style="position:absolute; right:30px; top:50%; transform:translateY(-50%);">
                <i class="bi bi-eye-slash"></i>
            </button>
        </div>
    </div>

    <div class="form-group mt-3 d-flex justify-content-center">
        <div class="col-md-10 d-flex justify-content-center">
            <button type="submit" class="btn btn-success w-75 btn-lg">
                Cambiar contraseña <i class="bi bi-arrow-right-circle-fill"></i>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function toggle(idBtn, idInput) {
            const btn = document.getElementById(idBtn);
            const input = document.getElementById(idInput);

            if (btn && input) {
                btn.addEventListener('click', function () {
                    const type = input.type === 'password' ? 'text' : 'password';
                    input.type = type;
                    this.querySelector('i').classList.toggle('bi-eye');
                    this.querySelector('i').classList.toggle('bi-eye-slash');
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            toggle('togglePasswordActual', 'PasswordActual');
            toggle('togglePassword', 'Password');
            toggle('toggleConfirmPassword', 'ConfirmPassword');
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
